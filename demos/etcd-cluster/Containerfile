# etcd cluster node image for demos/etcd-cluster.
#
# qarax boots it from OverlayBD with qarax-init as PID 1 (no systemd), which
# runs the CMD below with the image's ENV. CLUSTER_MEMBERS (name=peer-url,...)
# comes from run.sh's node list; etcd-node.sh picks this node's entry by the
# IP qarax assigned to eth0.
#
# Built and pushed by ./demos/etcd-cluster/run.sh, whose import converts it to OverlayBD. By
# hand (the local stack's registry is published on localhost:5001):
#   docker build -f demos/etcd-cluster/Containerfile -t localhost:5001/etcd-node:src \
#     --build-arg CLUSTER_MEMBERS=etcd-0=http://10.100.0.10:2380,etcd-1=http://10.100.0.11:2380,etcd-2=http://10.100.0.12:2380 \
#     demos/etcd-cluster/
#   docker push localhost:5001/etcd-node:src

FROM fedora:43

ARG ETCD_VERSION=v3.5.21

# iproute for etcd-node.sh; procps-ng so `qarax vm exec <vm> -- ps aux` works
RUN dnf install -y iproute procps-ng && dnf clean all

# etcd and etcdctl static binaries
RUN curl -fsSL \
    "https://github.com/etcd-io/etcd/releases/download/${ETCD_VERSION}/etcd-${ETCD_VERSION}-linux-amd64.tar.gz" \
    | tar -xz --strip-components=1 -C /usr/local/bin/ \
      "etcd-${ETCD_VERSION}-linux-amd64/etcd" \
      "etcd-${ETCD_VERSION}-linux-amd64/etcdctl" && \
    chmod +x /usr/local/bin/etcd /usr/local/bin/etcdctl && \
    mkdir -p /var/lib/etcd

COPY etcd-node.sh /usr/local/bin/etcd-node.sh
RUN chmod +x /usr/local/bin/etcd-node.sh

# Last, so changing the node layout only rebuilds this layer.
ARG CLUSTER_MEMBERS
ENV CLUSTER_MEMBERS="${CLUSTER_MEMBERS}"

CMD ["/usr/local/bin/etcd-node.sh"]
