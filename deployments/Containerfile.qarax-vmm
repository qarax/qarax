# Containerfile for qarax VMM Host Image
# This creates a bootable container image with qarax-node, Cloud Hypervisor,
# and Firecracker for use as a Virtual Machine Manager (VMM) host.
#
# Build instructions:
#   cargo build --release -p qarax-node
#   podman build -f deployments/Containerfile.qarax-vmm -t quay.io/yourorg/qarax-vmm-host:latest .
#   podman push quay.io/yourorg/qarax-vmm-host:latest
#
# Deploy to host:
#   ssh root@vmm-host "bootc switch quay.io/yourorg/qarax-vmm-host:latest && systemctl reboot"

FROM quay.io/centos-bootc/centos-bootc:stream10

# Build arguments for version pinning
ARG CLOUD_HYPERVISOR_VERSION
ARG FIRECRACKER_VERSION
ARG QARAX_VERSION=0.1.0

# Install system dependencies for running VMs
RUN dnf install -y \
    # QEMU utilities for disk image management
    qemu-img \
    # Networking tools
    iproute-tc \
    socat \
    iptables \
    nftables \
    passt \
    # Storage tools
    lvm2 \
    e2fsprogs \
    iscsi-initiator-utils \
    # OverlayBD / TCMU RPM extraction
    cpio \
    # Monitoring and debugging
    strace \
    tcpdump \
    # System utilities
    vim-minimal \
    curl \
    && dnf clean all

# Install Cloud Hypervisor
RUN curl -fsSL \
    "https://github.com/cloud-hypervisor/cloud-hypervisor/releases/download/${CLOUD_HYPERVISOR_VERSION:?set CLOUD_HYPERVISOR_VERSION}/cloud-hypervisor-static" \
    -o /usr/local/bin/cloud-hypervisor && \
    chmod +x /usr/local/bin/cloud-hypervisor && \
    cloud-hypervisor --version

# Install Firecracker
RUN curl -fsSL \
    "https://github.com/firecracker-microvm/firecracker/releases/download/${FIRECRACKER_VERSION:?set FIRECRACKER_VERSION}/firecracker-${FIRECRACKER_VERSION}-x86_64.tgz" \
    -o /tmp/firecracker.tgz && \
    tar -xzf /tmp/firecracker.tgz -C /tmp && \
    mv /tmp/release-${FIRECRACKER_VERSION}-x86_64/firecracker-${FIRECRACKER_VERSION}-x86_64 /usr/local/bin/firecracker && \
    chmod +x /usr/local/bin/firecracker && \
    rm -rf /tmp/firecracker.tgz /tmp/release-${FIRECRACKER_VERSION}-x86_64 && \
    firecracker --version

# OverlayBD and ACI pins come from versions/node-artifacts.env, read through a
# bind mount. NODE_ARTIFACTS_SHA (its checksum, passed by `make appliance-build`)
# busts the layer cache on a pin change under podman/buildah, whose cache key
# doesn't cover mounted files the way BuildKit's does.
ARG NODE_ARTIFACTS_SHA

# Install overlaybd-tcmu (provides the TCMU block-device backend for OverlayBD images).
# Files are extracted manually via rpm2cpio to avoid running RPM scriptlets.
RUN --mount=type=bind,source=versions/node-artifacts.env,target=/tmp/node-artifacts.env \
    . /tmp/node-artifacts.env && \
    curl -fsSL \
    "https://github.com/containerd/overlaybd/releases/download/v${OVERLAYBD_VERSION}/overlaybd-${OVERLAYBD_VERSION}-${OVERLAYBD_RPM_SUFFIX}.${OVERLAYBD_RPM_DIST}.x86_64.rpm" \
    -o /tmp/overlaybd.rpm && \
    cd / && rpm2cpio /tmp/overlaybd.rpm | cpio -idm --no-absolute-filenames 2>/dev/null && \
    rm /tmp/overlaybd.rpm

# Patch overlaybd config to use writable paths under /var (bootc makes /opt read-only).
RUN sed -i \
    -e 's|/opt/overlaybd/registry_cache|/var/lib/overlaybd/registry_cache|g' \
    -e 's|/opt/overlaybd/gzip_cache|/var/lib/overlaybd/gzip_cache|g' \
    -e 's|/opt/overlaybd/cred.json|/etc/overlaybd/cred.json|g' \
    /etc/overlaybd/overlaybd.json && \
    cp /opt/overlaybd/cred.json /etc/overlaybd/cred.json 2>/dev/null || \
    echo '{"auths":{}}' > /etc/overlaybd/cred.json

# Install the overlaybd-snapshotter convertor (statically-linked Go binary).
# Used to convert OCI images to OverlayBD format.
RUN --mount=type=bind,source=versions/node-artifacts.env,target=/tmp/node-artifacts.env \
    . /tmp/node-artifacts.env && \
    curl -fsSL \
    "https://github.com/containerd/accelerated-container-image/releases/download/v${ACI_VERSION}/overlaybd-snapshotter-${ACI_VERSION}-${ACI_RPM_SUFFIX}.x86_64.rpm" \
    -o /tmp/aci.rpm && \
    cd / && rpm2cpio /tmp/aci.rpm | cpio -idm --no-absolute-filenames 2>/dev/null && \
    rm /tmp/aci.rpm

# The guest kernel OCI-image and kernel-boot VMs start (the control plane's
# vm_defaults.kernel), and the UEFI firmware disk-image VMs boot with. Kept in
# /usr so bootc switch updates them; tmpfiles links the kernel into
# /var/lib/qarax/images under both configured names.
RUN --mount=type=bind,source=versions/node-artifacts.env,target=/tmp/node-artifacts.env \
    . /tmp/node-artifacts.env && \
    mkdir -p /usr/lib/qarax/images /usr/share/cloud-hypervisor && \
    curl -fsSL \
    "https://github.com/cloud-hypervisor/linux/releases/download/${CH_KERNEL_TAG}/vmlinux-x86_64" \
    -o /usr/lib/qarax/images/vmlinux && \
    curl -fsSL \
    "https://github.com/cloud-hypervisor/edk2/releases/download/${CLOUDHV_FW_TAG}/CLOUDHV.fd" \
    -o /usr/share/cloud-hypervisor/CLOUDHV.fd && \
    chmod 644 /usr/lib/qarax/images/vmlinux /usr/share/cloud-hypervisor/CLOUDHV.fd

# Copy qarax-node and qarax-init binaries (must be built before image build)
# Build with: cargo build --release -p qarax-node && cargo build --release -p qarax-init
COPY target/x86_64-unknown-linux-musl/release/qarax-node /usr/local/bin/qarax-node
COPY target/x86_64-unknown-linux-musl/release/qarax-init /usr/local/bin/qarax-init
RUN chmod +x /usr/local/bin/qarax-node /usr/local/bin/qarax-init

# Set root password for console access (password: qarax)
# For production, use SSH keys instead
RUN echo "root:qarax" | chpasswd

# Setup qarax-node systemd service
COPY deployments/qarax-node.service /etc/systemd/system/qarax-node.service
COPY deployments/overlaybd-tcmu.service /etc/systemd/system/overlaybd-tcmu.service
RUN systemctl enable overlaybd-tcmu qarax-node

# Configure system for VM workloads
COPY deployments/vm-network.conf /etc/sysctl.d/99-vm-network.conf
COPY deployments/vm-modules.conf /etc/modules-load.d/vm-modules.conf

# Create necessary directories via tmpfiles.d (bootc/ostree preserves /var
# as a state directory — RUN mkdir only works on first boot, not after
# bootc switch from a different image).
RUN printf '%s\n' \
    'd /var/lib/qarax      0755 root root -' \
    'd /var/lib/qarax/vms  0755 root root -' \
    'd /var/lib/qarax/images 0755 root root -' \
    'L /var/lib/qarax/images/vmlinux - - - - /usr/lib/qarax/images/vmlinux' \
    'L /var/lib/qarax/images/vmlinux-production - - - - /usr/lib/qarax/images/vmlinux' \
    'd /var/lib/qarax/disks 0755 root root -' \
    'd /var/lib/qarax/overlaybd 0755 root root -' \
    'd /var/lib/overlaybd 0755 root root -' \
    'd /var/lib/overlaybd/registry_cache 0755 root root -' \
    'd /var/lib/overlaybd/gzip_cache 0755 root root -' \
    > /etc/tmpfiles.d/qarax.conf && \
    mkdir -p /etc/qarax-node

# Configure networking for VMs
# Enable IP forwarding and bridge networking
RUN echo "net.ipv4.ip_forward = 1" >> /etc/sysctl.d/99-vm-network.conf && \
    echo "net.ipv6.conf.all.forwarding = 1" >> /etc/sysctl.d/99-vm-network.conf && \
    echo "net.bridge.bridge-nf-call-iptables = 0" >> /etc/sysctl.d/99-vm-network.conf

# Load required kernel modules for VM networking
RUN echo "kvm" >> /etc/modules-load.d/vm-modules.conf && \
    echo "kvm_intel" >> /etc/modules-load.d/vm-modules.conf && \
    echo "vhost_net" >> /etc/modules-load.d/vm-modules.conf && \
    echo "tap" >> /etc/modules-load.d/vm-modules.conf && \
    echo "tun" >> /etc/modules-load.d/vm-modules.conf

# Note: Firewall configuration should be done after boot via systemd service or ansible

# Image metadata
LABEL name="qarax-vmm-host" \
    version="${QARAX_VERSION}" \
    cloud-hypervisor-version="${CLOUD_HYPERVISOR_VERSION}" \
    firecracker-version="${FIRECRACKER_VERSION}" \
    description="bootc image for qarax Virtual Machine Manager hosts with Cloud Hypervisor and Firecracker" \
    maintainer="qarax team" \
    usage="bootc switch quay.io/yourorg/qarax-vmm-host:latest && systemctl reboot"

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD systemctl is-active qarax-node || exit 1
