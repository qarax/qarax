# The control plane (qarax-server) on a host. Install the release binary as
# /usr/local/bin/qarax-server, the configuration/ directory as
# /etc/qarax/configuration, and put the settings in /etc/qarax/qarax.env
# (see docs/INSTALL.md).
[Unit]
Description=qarax control plane
Documentation=https://github.com/qarax/qarax
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/qarax-server
Restart=always
RestartSec=5

User=qarax
Group=qarax
# Host deploys pin each host's SSH key in $HOME/.ssh/known_hosts.
StateDirectory=qarax
Environment=HOME=/var/lib/qarax
Environment=APP_ENVIRONMENT=production
Environment=QARAX_CONFIG_DIR=/etc/qarax/configuration
# DATABASE_*, AUTH_TOKENS, NODE_TLS_DIR, VM_*: see docs/INSTALL.md
EnvironmentFile=/etc/qarax/qarax.env

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=qarax

[Install]
WantedBy=multi-user.target
