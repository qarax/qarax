# Pins for the artifacts every node image downloads: e2e/Dockerfile.qarax-node,
# deployments/Containerfile.qarax-vmm and demos/hyperconverged/Containerfile.control-plane.
# The Containerfiles read this file through a build-time bind mount
# (RUN --mount=type=bind,source=versions/node-artifacts.env,...), so a change
# here invalidates exactly the layers that use it.
# Cloud Hypervisor and Firecracker stay in their own files next to this one,
# since they move together with the SDK tags in qarax-node/Cargo.toml.

# https://github.com/containerd/overlaybd/releases
OVERLAYBD_VERSION=1.0.16
OVERLAYBD_RPM_SUFFIX=20250818.4601fb2
OVERLAYBD_RPM_DIST=azurelinux.3.0

# https://github.com/containerd/accelerated-container-image/releases
ACI_VERSION=1.4.1
ACI_RPM_SUFFIX=20260114025326.c6ba42c

# https://github.com/cloud-hypervisor/edk2/releases (CLOUDHV.fd UEFI firmware)
CLOUDHV_FW_TAG=ch-a54f262b09

# https://github.com/cloud-hypervisor/linux/releases (guest vmlinux)
CH_KERNEL_TAG=ch-release-v6.16.9-20251112
