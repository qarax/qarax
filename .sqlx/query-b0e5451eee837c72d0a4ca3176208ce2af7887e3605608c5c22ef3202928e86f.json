{
  "db_name": "PostgreSQL",
  "query": "\nUPDATE host_gpus\nSET vm_id = $1, updated_at = NOW()\nWHERE id IN (\n    SELECT id FROM host_gpus\n    WHERE host_id = $2\n      AND vm_id IS NULL\n      AND ($3::VARCHAR IS NULL OR vendor = $3)\n      AND ($4::VARCHAR IS NULL OR model = $4)\n      AND ($5::BIGINT IS NULL OR vram_bytes >= $5)\n    ORDER BY pci_address\n    FOR UPDATE SKIP LOCKED\n    LIMIT $6\n)\nRETURNING id, host_id, pci_address, model, vendor, vram_bytes, iommu_group, numa_node, vm_id, discovered_at, updated_at\n        ",
