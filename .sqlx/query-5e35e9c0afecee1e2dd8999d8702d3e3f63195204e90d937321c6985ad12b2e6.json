  "query": "\nSELECT id, name, url, secret, scope AS \"scope: _\", scope_value, events, active,\n       created_at, updated_at\nFROM lifecycle_hooks\nWHERE ($1::text IS NULL OR name = $1)\n  AND ($2::text IS NULL OR (name, id) > ($2, $3::uuid))\nORDER BY name, id\nLIMIT $4\n        ",
