  "query": "\nSELECT id,\n        name,\n        description as \"description?\",\n        kernel_image_id,\n        kernel_params as \"kernel_params?\",\n        initrd_image_id as \"initrd_image_id?\"\nFROM boot_sources\nWHERE ($1::text IS NULL OR name = $1)\n  AND ($2::text IS NULL OR (name, id) > ($2, $3::uuid))\nORDER BY name, id\nLIMIT $4\n        ",
