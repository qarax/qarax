  "db_name": "PostgreSQL",
  "query": "\nSELECT b.id,\n       b.name,\n       b.created_at,\n       b.storage_object_id,\n       o.name AS \"object_name!\",\n       o.storage_pool_id AS \"storage_pool_id!\",\n       o.size_bytes AS \"size_bytes!\",\n       o.config AS \"object_config!\"\nFROM backups b\nJOIN storage_objects o ON o.id = b.storage_object_id\nWHERE b.backup_type = 'DATABASE'\n        ",
