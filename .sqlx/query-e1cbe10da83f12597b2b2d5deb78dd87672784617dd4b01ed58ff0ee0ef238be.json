{
  "db_name": "PostgreSQL",
  "query": "\nSELECT n.id,\n       n.name,\n       n.subnet::text AS \"subnet!\",\n       n.gateway::text AS gateway,\n       n.dns::text AS dns,\n       n.vpc_name,\n       n.type AS network_type,\n       n.status AS \"status: NetworkStatus\",\n       hn.bridge_name,\n       hn.parent_interface\nFROM networks n\nJOIN host_networks hn ON hn.network_id = n.id\nWHERE hn.host_id = $1\nORDER BY n.name\n            ",
