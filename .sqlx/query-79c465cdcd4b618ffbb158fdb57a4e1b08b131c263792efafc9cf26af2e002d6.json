{
  "db_name": "PostgreSQL",
  "query": "\nSELECT id, name, url, secret, scope AS \"scope: _\", scope_value, events, active,\n       created_at, updated_at\nFROM lifecycle_hooks\nWHERE active = TRUE\n  AND (\n      scope = 'GLOBAL'\n      OR (scope = 'VM'  AND scope_value = $1::text)\n      OR (scope = 'TAG' AND scope_value = ANY($2))\n  )\n  AND (\n      events = ARRAY[]::TEXT[]\n      OR $3 = ANY(events)\n  )\n        ",
