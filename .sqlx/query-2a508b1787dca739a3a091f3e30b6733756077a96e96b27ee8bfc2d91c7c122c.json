{
  "db_name": "PostgreSQL",
  "query": "\nSELECT spm.id,\n       spm.sandbox_pool_id,\n       spm.vm_id,\n       spm.status AS \"status: _\",\n       spm.error_message,\n       spm.created_at,\n       spm.updated_at\nFROM sandbox_pool_members spm\nJOIN sandbox_pools sp\n  ON sp.id = spm.sandbox_pool_id\nWHERE sp.vm_template_id = $1\n  AND spm.status = 'READY'\nORDER BY spm.created_at\nFOR UPDATE OF spm SKIP LOCKED\nLIMIT 1\n        ",
