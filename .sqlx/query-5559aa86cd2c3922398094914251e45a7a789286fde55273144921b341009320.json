{
  "db_name": "PostgreSQL",
  "query": "\nSELECT m.id,\n       m.sandbox_pool_id,\n       m.vm_id,\n       m.status AS \"status: _\",\n       m.error_message,\n       m.created_at,\n       m.updated_at,\n       v.status AS \"vm_status: _\",\n       v.host_id,\n       COALESCE(h.status = 'UP', false) AS \"host_up!\"\nFROM sandbox_pool_members m\nJOIN vms v\n  ON v.id = m.vm_id\nLEFT JOIN hosts h\n  ON h.id = v.host_id\nWHERE m.sandbox_pool_id = $1 AND m.seed\nORDER BY m.created_at, m.id\n        ",
