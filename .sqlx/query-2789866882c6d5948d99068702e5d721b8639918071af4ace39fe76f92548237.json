  "query": "\nSELECT id,\n       vm_id,\n       vm_template_id,\n       name,\n       status AS \"status: _\",\n       idle_timeout_secs,\n       last_activity_at,\n       error_message,\n       created_at\nFROM sandboxes\nWHERE status = 'READY'\n  AND last_activity_at + (idle_timeout_secs || ' seconds')::interval < NOW()\n        ",
