{
  "db_name": "PostgreSQL",
  "query": "\nSELECT id, name, subnet::text AS \"subnet!\", gateway::text, dns::text, vpc_name, type AS network_type, status AS \"status: _\"\nFROM networks\nWHERE ($1::text IS NULL OR name = $1)\n  AND ($2::text IS NULL OR (name, id) > ($2, $3::uuid))\nORDER BY name, id\nLIMIT $4\n        ",
