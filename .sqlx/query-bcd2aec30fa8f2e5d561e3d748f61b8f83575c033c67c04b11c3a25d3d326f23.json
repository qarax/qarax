{
  "db_name": "PostgreSQL",
  "query": "\nSELECT seed.sandbox_pool_id,\n       seed.vm_id,\n       v.host_id,\n       seed.status AS \"status: SandboxPoolMemberStatus\"\nFROM sandbox_pool_members seed\nJOIN vms v\n  ON v.id = seed.vm_id\nWHERE seed.sandbox_pool_id = ANY($1)\n  AND seed.seed\nORDER BY seed.created_at, seed.id\n        ",
