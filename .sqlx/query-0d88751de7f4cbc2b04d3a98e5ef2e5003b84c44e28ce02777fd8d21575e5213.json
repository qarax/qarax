  "query": "\nSELECT id,\n       name,\n       description,\n       hypervisor AS \"hypervisor: _\",\n       boot_vcpus,\n       max_vcpus,\n       cpu_topology AS \"cpu_topology: _\",\n       kvm_hyperv,\n       memory_size,\n       memory_hotplug_size,\n       memory_mergeable,\n       memory_shared,\n       memory_hugepages,\n       memory_hugepage_size,\n       memory_prefault,\n       memory_thp,\n       boot_source_id,\n       root_disk_object_id,\n       boot_mode AS \"boot_mode: _\",\n       image_ref,\n       cloud_init_user_data,\n       cloud_init_meta_data,\n       cloud_init_network_config,\n       network_id,\n       networks AS \"networks: _\",\n       config AS \"config: _\"\nFROM vm_templates\nWHERE ($1::text IS NULL OR name = $1)\nORDER BY name\n        ",
