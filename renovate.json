{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "cargo": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Match the cargo dependency cooldown in .cargo/config.toml",
      "matchDatasources": ["crate"],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchPackageNames": ["cloud-hypervisor-sdk"],
      "groupName": "cloud-hypervisor-sdk",
      "automerge": false
    },
    {
      "matchPackageNames": ["firecracker-rust-sdk"],
      "groupName": "firecracker-rust-sdk",
      "automerge": false
    }
  ]
}
