# The bootc qarax node used by the node-upgrade e2e tests and by
# `make run-local VM=1`: the real appliance image (deployments/
# Containerfile.qarax-vmm) plus what a test node needs on top. The disk is
# made with `bootc install to-disk` (e2e/build-bootc-node.sh) and booted as a
# Cloud Hypervisor microVM by the bootc-vm compose service (Dockerfile.bootc-vm).
#
# Networking inside the VM: the runner container is the guest's gateway at
# 10.0.2.2, and its port 5000 is the compose registry. The hosts entry below
# names that address "registry", so the stack's OverlayBD pool URL
# (http://registry:5000) works from this node as it does from the container
# node.

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Root SSH with a password, for the deploy/upgrade tests (host_deployer).
RUN mkdir -p /etc/ssh/sshd_config.d && \
    printf 'PermitRootLogin yes\nPasswordAuthentication yes\n' \
        > /etc/ssh/sshd_config.d/01-qarax-test.conf && \
    echo 'root:testpassword' | chpasswd && \
    systemctl enable sshd

# bootc switch pulls 10.0.2.2:5000/... over plain HTTP.
COPY <<'EOF' /etc/containers/registries.conf.d/01-local-test.conf
[[registry]]
location = "10.0.2.2:5000"
insecure = true

[[registry]]
location = "registry:5000"
insecure = true
EOF

# Name the gateway "registry" at boot (/etc/hosts can't be changed in a build).
COPY <<'EOF' /etc/systemd/system/qarax-test-registry-host.service
[Unit]
Description=Resolve the compose registry name to the bootc-vm gateway
Before=qarax-node.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'grep -q " registry$" /etc/hosts || echo "10.0.2.2 registry" >> /etc/hosts'

[Install]
WantedBy=multi-user.target
EOF
RUN systemctl enable qarax-test-registry-host

# Each versioned test image sets QARAX_NODE_VERSION in version.env.
RUN mkdir -p /etc/systemd/system/qarax-node.service.d && \
    printf '[Service]\nEnvironmentFile=-/etc/qarax-node/version.env\n' \
        > /etc/systemd/system/qarax-node.service.d/10-version.conf
