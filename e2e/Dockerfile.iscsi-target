# LIO iSCSI target for BLOCK storage pools (compose service iscsi-target): the
# e2e BLOCK tests and demos/block-storage use it.
#
# Provisions a fileio-backed LUN via targetcli at container start (see
# iscsi-target-entrypoint.sh) and listens on port 3260. The LIO objects live in
# the host kernel via the bind-mounted /sys/kernel/config.
FROM quay.io/centos/centos:stream9

RUN dnf install -y --setopt=install_weak_deps=False \
    targetcli \
    python3-rtslib \
    dbus-daemon \
    iproute \
    kmod \
    util-linux \
    && dnf clean all

RUN mkdir -p /var/lib/qarax-block /etc/target

COPY e2e/iscsi-target-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 3260

ENTRYPOINT ["/entrypoint.sh"]
