# Dockerfile for qarax-node container (E2E testing)
# Runs qarax-node with Cloud Hypervisor for VM management

# The test initramfs that VMs on the local/e2e stack boot by default
# (VM_INITRAMFS): qarax-init as PID 1, busybox, and dropbear for SSH with a key
# the node holds. Its own stage, so the bootc test node
# (Containerfile.bootc-node) ships the same file and key. Network is configured
# statically by the kernel via the ip= cmdline parameter.
FROM fedora:43 AS test-initramfs
RUN dnf install -y busybox dropbear cpio gzip && dnf clean all
# Everything but /init, so a code change only redoes the cpio step below.
RUN mkdir -p /opt/test-initramfs/{dev,proc,sys,sbin,bin,etc/dropbear,var/run,lib64,root/.ssh} && \
    cd /opt/test-initramfs && \
    echo '{"cmd":["/bin/sh","-c","/sbin/dropbear -F -E -R & while true; do sleep 3600; done"]}' > .qarax-config.json && \
    cp /usr/sbin/busybox bin/busybox && \
    for cmd in sh ping ip sleep echo uname cat ls pwd true false; do ln -s busybox bin/$cmd; done && \
    cp /usr/sbin/dropbear sbin/ && \
    cp /lib64/libtomcrypt.so.1 /lib64/libtommath.so.1 /lib64/libz.so.1 \
       /lib64/libcrypt.so.2 /lib64/libc.so.6 /lib64/ld-linux-x86-64.so.2 lib64/ && \
    echo "root:x:0:0:root:/root:/bin/sh" > etc/passwd && \
    echo "root:wiAqZ3Z0Hh3Vw:19766:0:99999:7:::" > etc/shadow && \
    dropbearkey -t rsa -f /root/.ssh/id_rsa && \
    dropbearkey -y -f /root/.ssh/id_rsa | grep "^ssh-rsa " > root/.ssh/authorized_keys && \
    dropbearconvert dropbear openssh /root/.ssh/id_rsa /root/.ssh/id_rsa.openssh && \
    chmod 600 root/.ssh/authorized_keys && \
    chmod 700 root/.ssh root
COPY target/x86_64-unknown-linux-musl/release/qarax-init /opt/test-initramfs/init
RUN chmod +x /opt/test-initramfs/init && \
    cd /opt/test-initramfs && \
    find . | cpio -o -H newc | gzip > /test-initramfs.gz

FROM fedora:43

# Each ARG is declared right before the step that uses it: every RUN after
# an ARG sees it in its environment, so a version bump declared at the top
# would also invalidate the cached package install below.
ENV CURL_RETRY_ARGS="--fail --show-error --silent --location --retry 5 --retry-delay 5 --retry-all-errors --connect-timeout 30 --max-time 1800"

# Install dependencies including kernel for vmlinux extraction
RUN dnf install -y \
    qemu-img \
    iproute-tc \
    socat \
    # The nft backend, as on the CentOS Stream appliance. Fedora's plain
    # iptables package is the legacy backend, which needs the host's ip_tables
    # module and fails after a kernel upgrade without a reboot.
    iptables-nft \
    nftables \
    tcpdump \
    passt \
    nmap-ncat \
    curl \
    xz \
    cpio \
    gzip \
    e2fsprogs \
    nfs-utils \
    guestfs-tools \
    iscsi-initiator-utils \
    dropbear \
    && dnf clean all

# Install Cloud Hypervisor (static binary)
ARG CLOUD_HYPERVISOR_VERSION
RUN curl ${CURL_RETRY_ARGS} \
    "https://github.com/cloud-hypervisor/cloud-hypervisor/releases/download/${CLOUD_HYPERVISOR_VERSION:?set CLOUD_HYPERVISOR_VERSION}/cloud-hypervisor-static" \
    -o /usr/local/bin/cloud-hypervisor && \
    chmod +x /usr/local/bin/cloud-hypervisor && \
    cloud-hypervisor --version

# Install Firecracker (static binary)
ARG FIRECRACKER_VERSION=v1.17.0
RUN curl ${CURL_RETRY_ARGS} \
    "https://github.com/firecracker-microvm/firecracker/releases/download/${FIRECRACKER_VERSION}/firecracker-${FIRECRACKER_VERSION}-x86_64.tgz" \
    -o /tmp/firecracker.tgz && \
    tar -xzf /tmp/firecracker.tgz -C /tmp && \
    mv /tmp/release-${FIRECRACKER_VERSION}-x86_64/firecracker-${FIRECRACKER_VERSION}-x86_64 /usr/local/bin/firecracker && \
    chmod +x /usr/local/bin/firecracker && \
    rm -rf /tmp/firecracker.tgz /tmp/release-${FIRECRACKER_VERSION}-x86_64 && \
    firecracker --version

# Pins for the downloads below come from versions/node-artifacts.env, read
# through a bind mount so a pin change invalidates exactly these layers.

# Install Cloud Hypervisor UEFI firmware (CLOUDHV.fd).
# This is the EDK2-based UEFI firmware from the cloud-hypervisor/edk2 project.
# Unlike standard OVMF, it supports the PVH entry point required by Cloud Hypervisor's
# --firmware option, and can boot standard OS images (Fedora, Ubuntu, etc.).
RUN --mount=type=bind,source=versions/node-artifacts.env,target=/tmp/node-artifacts.env \
    . /tmp/node-artifacts.env && \
    mkdir -p /usr/share/cloud-hypervisor && \
    curl ${CURL_RETRY_ARGS} \
    "https://github.com/cloud-hypervisor/edk2/releases/download/${CLOUDHV_FW_TAG}/CLOUDHV.fd" \
    -o /usr/share/cloud-hypervisor/CLOUDHV.fd && \
    chmod 644 /usr/share/cloud-hypervisor/CLOUDHV.fd

# Install overlaybd-tcmu (provides the TCMU block-device backend for OverlayBD images).
# The el8 RPM is used because it matches the overlaybd build environment; files are
# extracted manually to avoid running RPM scriptlets in the container.
RUN --mount=type=bind,source=versions/node-artifacts.env,target=/tmp/node-artifacts.env \
    . /tmp/node-artifacts.env && \
    curl ${CURL_RETRY_ARGS} \
    "https://github.com/containerd/overlaybd/releases/download/v${OVERLAYBD_VERSION}/overlaybd-${OVERLAYBD_VERSION}-${OVERLAYBD_RPM_SUFFIX}.${OVERLAYBD_RPM_DIST}.x86_64.rpm" \
    -o /tmp/overlaybd.rpm && \
    cd / && rpm2cpio /tmp/overlaybd.rpm | cpio -idm --no-absolute-filenames && \
    mkdir -p /opt/overlaybd/registry_cache /opt/overlaybd/gzip_cache && \
    rm /tmp/overlaybd.rpm

# Install the overlaybd-snapshotter convertor (statically-linked Go binary).
# Used to convert OCI images to OverlayBD format.
RUN --mount=type=bind,source=versions/node-artifacts.env,target=/tmp/node-artifacts.env \
    . /tmp/node-artifacts.env && \
    curl ${CURL_RETRY_ARGS} \
    "https://github.com/containerd/accelerated-container-image/releases/download/v${ACI_VERSION}/overlaybd-snapshotter-${ACI_VERSION}-${ACI_RPM_SUFFIX}.x86_64.rpm" \
    -o /tmp/aci.rpm && \
    cd / && rpm2cpio /tmp/aci.rpm | cpio -idm --no-absolute-filenames && \
    rm /tmp/aci.rpm

# Create directories for VM data
# (kept before binary COPY so this layer stays cached across binary rebuilds)
RUN mkdir -p /var/lib/qarax/vms \
    /var/lib/qarax/images \
    /var/lib/qarax/disks \
    /var/lib/qarax/overlaybd \
    /etc/qarax-node

# Download Cloud Hypervisor kernel (vmlinux)
# This kernel has CONFIG_VIRTIO_FS=y (built-in)
# Placed before binary COPY so this expensive download stays cached across rebuilds.
RUN --mount=type=bind,source=versions/node-artifacts.env,target=/tmp/node-artifacts.env \
    . /tmp/node-artifacts.env && \
    curl ${CURL_RETRY_ARGS} \
    "https://github.com/cloud-hypervisor/linux/releases/download/${CH_KERNEL_TAG}/vmlinux-x86_64" \
    -o /var/lib/qarax/images/vmlinux && \
    chmod 644 /var/lib/qarax/images/vmlinux && \
    ls -la /var/lib/qarax/images/

# Copy qarax-node and qarax-init binaries
COPY target/x86_64-unknown-linux-musl/release/qarax-node /usr/local/bin/qarax-node
COPY target/x86_64-unknown-linux-musl/release/qarax-init /usr/local/bin/qarax-init
RUN chmod +x /usr/local/bin/qarax-node /usr/local/bin/qarax-init

# The test initramfs and the key its dropbear trusts (e2e tests and demos SSH
# into guests from here). guest-ssh is the same command on the bootc test node.
COPY --from=test-initramfs /test-initramfs.gz /var/lib/qarax/images/test-initramfs.gz
COPY --from=test-initramfs /root/.ssh/id_rsa /root/.ssh/id_rsa
COPY <<'EOF' /usr/local/bin/guest-ssh
#!/bin/sh
# SSH into a test-initramfs guest: guest-ssh root@IP [COMMAND...]
exec dbclient -y -y -i /root/.ssh/id_rsa "$@"
EOF
RUN chmod +x /usr/local/bin/guest-ssh

COPY e2e/entrypoint-qarax-node.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 50051

CMD ["/entrypoint.sh"]
